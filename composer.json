{
    "name": "moffhub/connector-sdk",
    "description": "SDK for building MPS-compliant payment connectors",
    "type": "library",
    "license": "MIT",
    "keywords": ["payments", "mps", "moffhub", "connector", "sdk"],
    "homepage": "https://github.com/Moffhub-Solutions/connector-sdk",
    "support": {
        "issues": "https://github.com/Moffhub-Solutions/connector-sdk/issues",
        "source": "https://github.com/Moffhub-Solutions/connector-sdk"
    },
    "authors": [
        { "name": "Moffhub", "homepage": "https://moffhub.com" }
    ],
    "require": {
        "php": "^8.3",
        "moffhub/mps-spec": "^0.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Moffhub\\ConnectorSdk\\": "src/"
        }
    },
    "minimum-stability": "stable"
}
